# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to .env.example — only placeholders.

# ============================================================
# Security / JWT (REQUIRED for auth)
# ============================================================
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# ============================================================
# OTP (email verification via Brevo)
# ============================================================
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10

# Brevo email — use ONE of:
#   REST API key (xkeysib-...)  OR  SMTP key (xsmtpsib-...) + BREVO_SMTP_LOGIN below
# Sender email must be verified in Brevo.
# ============================================================
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_EMAIL=alerts@yourdomain.com
BREVO_SENDER_NAME=Salevora Alerts
ALERT_COOLDOWN_HOURS=24

# ============================================================
# MongoDB Atlas (recommended for production)
# When set, users + OTP codes are stored in Atlas instead of SQLite.
# Get URI from Atlas → Database → Connect → Drivers → Python
# ============================================================
MONGODB_URI=
MONGODB_DB_NAME=salevora

# ============================================================
# Server (optional — api.py defaults shown below)
# Not read from env yet; set when running manually:
#   uvicorn api:app --host 0.0.0.0 --port 8000
# ============================================================
# API_HOST=0.0.0.0
# API_PORT=8000
