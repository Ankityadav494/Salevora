# Environment Variables Template
# Copy this file to .env and configure for your deployment

# ============================================================
# API Configuration
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
API_LOG_LEVEL=info

# ============================================================
# Data & Storage Configuration
# ============================================================
DATA_PATH=/app/data
BACKUP_PATH=/app/data/backup
ARCHIVE_OLD_DATA=true
DAYS_TO_KEEP=30

# ============================================================
# Security Configuration
# ============================================================
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# ============================================================
# CORS Configuration
# ============================================================
CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ============================================================
# Logging Configuration
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/salevora.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================================
# Monitoring & Observability
# ============================================================
SENTRY_DSN=
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
ENABLE_TRACING=false

# ============================================================
# Email Configuration (for notifications/alerts)
# ============================================================
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=admin@yourdomain.com
ALERT_ON_ERROR=true

# ============================================================
# Database Configuration (if using future DB)
# ============================================================
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============================================================
# Performance Tuning
# ============================================================
CACHE_ENABLED=true
CACHE_TTL=300
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=120
UPLOAD_TIMEOUT=180

# ============================================================
# Feature Flags
# ============================================================
ENABLE_FORECASTING=true
ENABLE_INVENTORY_TRACKING=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_API_DOCUMENTATION=true

# ============================================================
# Backup Configuration
# ============================================================
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_SCHEDULE=0 2 * * *
AUTO_BACKUP_LOCATION=/app/data/backup
KEEP_BACKUP_COUNT=7

# ============================================================
# CDN & Static Files
# ============================================================
CDN_ENABLED=false
CDN_URL=https://cdn.yourdomain.com
STATIC_CACHE_EXPIRE=86400

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

# ============================================================
# Development/Testing
# ============================================================
ENVIRONMENT=production
DEBUG=false
TESTING=false
